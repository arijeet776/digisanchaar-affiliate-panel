# DigiSanchaar — frontend environment reference.
# Copy to .env and fill in for your deployment. Never commit the real .env file.

# Base URL the frontend calls for the backend API. Defaults to the relative
# path "/api/v1" (works out of the box behind a reverse proxy that routes
# /api/v1 to the backend on the same origin). Set explicitly for a split
# frontend/backend deployment, e.g.: https://api.your-domain.com/api/v1
VITE_API_BASE_URL=
