# DigiSanchaar — backend environment reference.
# Copy to .env and fill in real values. Never commit the real .env file.
# Every field below is read exactly once, in app/config.py (Settings) —
# that module is the single source of truth for configuration.

ENVIRONMENT=development                 # development | staging | production
# In production the app REFUSES TO START unless ALL of these are explicitly set:
#   MONGO_URI, MONGO_DB_NAME, POSTGRES_DSN, JWT_SECRET_KEY (>= 32 chars, not a
#   placeholder) and ALLOWED_ORIGINS (no '*'). Set them through your platform's
#   secret store, never by committing a real .env.

# --- MongoDB (operational store — Parts 1-8, 10, 11) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=digisnr_dev

# --- PostgreSQL / Supabase (financial system of record — Part 9 ONLY) ---
# Postgres is authoritative for financial_ledger / withdrawals. Never point
# this at the same store as application/operational data.
POSTGRES_DSN=postgresql://user:password@localhost:5432/digisnr_dev

# --- Auth ---
# REQUIRED, no default (app will fail to start without it — by design).
# Generate a long random value per environment, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# (CORS_ALLOWED_ORIGINS is accepted as an alias.) A '*' is rejected in production.
ALLOWED_ORIGINS=http://localhost:5173

# --- Branding ---
BRAND_NAME=DigiSanchaar

# --- Tracking ---
# Bootstrap/default only. The DB-backed value set via System Settings ->
# Domain & Tracking is authoritative at runtime once configured there.
TRACKING_BASE_URL=

# --- Reverse proxy (production) ---
# uvicorn trusts X-Forwarded-* only from these addresses. docker-compose.yml
# sets this for the bundled nginx hop; set it to your proxy's address(es) if you
# deploy the backend another way. Leave unset when the backend is directly exposed.
# FORWARDED_ALLOW_IPS=

# --- Storage backend ---
# "supabase_rest" (recommended, set below) keeps everything in Supabase over HTTPS.
# "mongodb_supabase" is the older direct-driver mode (needs MONGO_URI / POSTGRES_DSN).
STORAGE_BACKEND=mongodb_supabase

# ---- Supabase over HTTPS only (STORAGE_BACKEND=supabase_rest) -------------------------------
# STORAGE_BACKEND=supabase_rest
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=            # SERVER-SIDE secret / service_role key. NEVER the publishable (anon) key,
#                                  # never in the frontend / VITE_*, never committed. Set it in Render only.
# SUPABASE_TIMEOUT_SECONDS=15
